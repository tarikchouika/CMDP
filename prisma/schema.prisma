// ═══════════════════════════════════════════════════════════════════════════
// CMDP — مخطط قاعدة البيانات (SQLite / Prisma)
// المنصة الرقمية لإدارة التعاونيات بالمملكة المغربية
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── مستخدمو المنصة ───────────────────────────────────────────────────────
// الأدوار (role): SUPER_ADMIN مالك المنصة أو سوبر أدمين | ADMIN مدير
//                 | COADMIN كوأدمن (رئيس تعاونية أو عضو مسير) | USER مستخدم عادي
// نوع الحساب (accountType): PRESIDENT رئيس | MANAGER عضو مسير
//                 MEMBER عضو غير مسير | CONTRACTOR متعاقد مع التعاونية
model User {
  // مرفقات الهوية (base64 JSON) — صورة شخصية + وثيقة هوية
  photo           String?
  idDocuments     String? // JSON: [{name,type,size,dataUrl}]

  // ── الملكية والتراتبية (الإصدار 1.3.2) ────────────────────────────────
  // المالك (isOwner=true): واحد لا يتعدد — يحتكر إدارة السوبر أدمين ونقل
  // الملكية؛ حسابه محمي من أي إجراء إداري. سوبر أدمين غير المالك: يديره
  // المالك حصراً وفق مسار عادل (إشعار ← توقيف ← إزالة).
  isOwner            Boolean   @default(false)
  // إجراء الإيقاف العادل (سوبر أدمين): إشعار موثق قبل التنفيذ
  suspensionNotice   String? // JSON: {reason,effectiveAt,issuedAt,issuedBy,response,respondedAt}
  suspensionReason   String? // سبب التوقيف النهائي الموثق
  suspendedAt        DateTime?

  id             Int           @id @default(autoincrement())
  username       String        @unique
  passwordHash   String
  fullName       String
  phone          String?
  email          String?
  cin            String? // رقم البطاقة الوطنية
  role           String        @default("USER") // SUPER_ADMIN | ADMIN | COADMIN | USER
  accountType    String? // PRESIDENT | MANAGER | MEMBER | CONTRACTOR
  cooperativeId  Int? // التعاونية التابع لها (COADMIN / USER)
  cooperative    Cooperative?  @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)
  status         String        @default("PENDING") // PENDING | ACTIVE | SUSPENDED | REJECTED
  createdAt      DateTime      @default(now())
  joinRequests   JoinRequest[]
  applications   OpportunityApplication[]
  votes          AssemblyVote[]
  attendances    AssemblyAttendee[]
  notifications  Notification[]
}

// ─── الإشعارات داخل المنصة (الإصدار 1.3.2) ──────────────────────────────
// قناة الإبلاغ الرسمية: إشعارات ما قبل/بعد التوقيف، نقل الملكية،
// والأحداث المهمة — تُعرض بجرس الإشعارات في الواجهة.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // SUSPENSION_NOTICE | SUSPENDED | REINSTATED | OWNERSHIP_TRANSFER | ACCOUNT_APPROVED | SYSTEM
  title     String
  body      String
  meta      String? // JSON إضافي (مواعيد، أسباب، روابط…)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

// ─── سجل الأحداث التدقيقي (الإصدار 1.3.2) ──────────────────────────────
// يوثق كل حدث مهم في المنصة بلا حذف: من فعل ماذا ومتى ولماذا.
// يبقى السجل بعد حذف الحسابات (المعرّف الاسمي لا علاقة قسرية) —
// مبدأ سجلات الحوكمة: التاريخ لا يُمحى.
model AuditLog {
  id            Int      @id @default(autoincrement())
  actorId       Int? // معرف الفاعل إن كان مسجلاً (بلا علاقة — يصمد بعد الحذف)
  actorUsername String // الاسم الاسمي وقت الحدث
  actorRole     String // SUPER_ADMIN | ADMIN | COADMIN | USER | anonymous
  action        String // auth.login | auth.login_failed | user.suspend | super_admin.add | ownership.transfer | …
  entityType    String // USER | COOPERATIVE | PLATFORM | TRANSACTION | …
  entityId      String?
  summary       String // وصف عربي مقروء
  details       String? // JSON: أسباب، قيم قبل/بعد، سياق
  severity      String   @default("INFO") // INFO | WARNING | CRITICAL
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([severity])
  @@index([entityType, entityId])
}

// ─── التعاونية ────────────────────────────────────────────────────────────
model Cooperative {
  products      Product[]
  // الوثائق القانونية المثبتة للوجود والنشاط (base64 JSON)
  legalDocuments  String? // JSON: [{name,type,size,dataUrl}]
  logo            String? // JSON: {name,type,size,dataUrl} — لوغو التعاونية

  id                 Int               @id @default(autoincrement())
  name               String
  registrationNumber String            @unique // رقم التسجيل بالسجل المحلي
  odcCardNumber      String? // بطاقة الاعتراف — مكتب تنمية التعاون
  sector             String // الفلاحة، الصناعة التقليدية، الخدمات...
  region             String // الجهة (12 جهة)
  province           String // الإقليم أو العمالة
  commune            String? // الجماعة
  presidentName      String // رئيس(ة) التعاونية
  phone              String?
  email              String?
  address            String?
  foundingDate       DateTime // تاريخ الجمع التأسيسي
  status             String            @default("ACTIVE") // ACTIVE | DORMANT | DISSOLVED
  approvalStatus     String            @default("APPROVED") // PENDING | APPROVED | REJECTED — حالة التسجيل لدى المنصة
  approvalNote       String? // ملاحظة المصادقة أو الرفض
  notes              String?
  createdAt          DateTime          @default(now())
  members            Member[]
  assemblies         Assembly[]
  meetings           Meeting[]
  transactions       Transaction[]
  documents          Document[]
  tasks              ComplianceTask[]
  users              User[]
  opportunities      Opportunity[]
  joinRequests       JoinRequest[]
}

// ─── العضو ────────────────────────────────────────────────────────────────
model Member {
  id            Int          @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  fullName      String
  cin           String? // رقم البطاقة الوطنية
  gender        String? // M | F
  phone         String?
  email         String?
  city          String?
  joinDate      DateTime     @default(now())
  shares        Int          @default(1) // عدد الحصص
  boardRole     String? // PRESIDENT | VICE | SECRETARY | TREASURER | AUDITOR | ADVISOR
  status        String       @default("ACTIVE") // ACTIVE | SUSPENDED | WITHDRAWN
  createdAt     DateTime     @default(now())
}

// ─── الجمع العام (العادي / الاستثنائي / التأسيسي) ─────────────────────────
model Assembly {
  id             Int          @id @default(autoincrement())
  cooperativeId  Int
  cooperative    Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  type           String // ORDINARY | EXTRAORDINARY | CONSTITUENT
  date           DateTime
  location       String?
  agenda         String // جدول الأعمال
  decisions      String? // القرارات والتوصيات
  attendeesCount Int          @default(0)
  status         String       @default("HELD") // SCHEDULED | HELD | CANCELLED
  createdAt      DateTime     @default(now())
  votes          AssemblyVote[]
  attendees      AssemblyAttendee[]
}

// ─── حضور الأعضاء للجموع العامة ───────────────────────────────────────────
model AssemblyAttendee {
  id          Int       @id @default(autoincrement())
  assemblyId  Int
  assembly    Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmed   Boolean   @default(true) // تأكيد الحضور
  createdAt   DateTime  @default(now())

  @@unique([assemblyId, userId])
}

// ─── تصويت الأعضاء على قرارات الجموع العامة ────────────────────────────────
model AssemblyVote {
  id          Int       @id @default(autoincrement())
  assemblyId  Int
  assembly    Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision    String // FOR | AGAINST | ABSTAIN
  createdAt   DateTime  @default(now())

  @@unique([assemblyId, userId])
}

// ─── اجتماع مجلس الإدارة ─────────────────────────────────────────────────
model Meeting {
  id             Int          @id @default(autoincrement())
  cooperativeId  Int
  cooperative    Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  date           DateTime
  agenda         String
  decisions      String?
  attendeesCount Int          @default(0)
  createdAt      DateTime     @default(now())
}

// ─── الحركات المالية ──────────────────────────────────────────────────────
model Transaction {
  // إثبات الحركة: فاتورة/وصل أداء (base64 JSON)
  proofFiles      String? // JSON: [{name,type,size,dataUrl}]

  id             Int          @id @default(autoincrement())
  cooperativeId  Int
  cooperative    Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  type           String // INCOME | EXPENSE
  category       String // اشتراكات، بيع المنتوجات، منح، تكاليف التسيير...
  amount         Float
  date           DateTime
  description    String?
  method         String       @default("CASH") // CASH | BANK | CHEQUE | MOBILE
  reference      String?
  createdAt      DateTime     @default(now())
}

// ─── سجل الوثائق ──────────────────────────────────────────────────────────
model Document {
  id             Int          @id @default(autoincrement())
  cooperativeId  Int
  cooperative    Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  title          String
  type           String // STATUTE | MINUTE | FINANCIAL | TAX | ODCO | CONTRACT | OTHER
  reference      String?
  issueDate      DateTime
  expiryDate     DateTime?
  status         String       @default("VALID") // VALID | EXPIRING | EXPIRED | ARCHIVED
  isShared       Boolean      @default(false) // مشاركة مع المتعاقدين والمصادق عليهم
  notes          String?
  createdAt      DateTime     @default(now())
}

// ─── الجهات الحكومية والإدارية الوصية ─────────────────────────────────────
model GovEntity {
  id           Int                 @id @default(autoincrement())
  name         String
  acronym      String?
  type         String // MINISTRY | OFFICE | AGENCY | INSTITUTE | COURT | LOCAL_AUTHORITY
  supervisor   String?
  missions     String
  website      String?
  phone        String?
  email        String?
  address      String?
  interactions EntityInteraction[]
}

// ─── التفاعلات مع الجهات (تصريحات، طلبات، مراسلات...) ─────────────────────
model EntityInteraction {
  id             Int         @id @default(autoincrement())
  entityId       Int
  entity         GovEntity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  cooperativeId  Int?
  date           DateTime
  type           String // DECLARATION | REQUEST | CORRESPONDENCE | VISIT | AUDIT | SUPPORT
  subject        String
  status         String      @default("DONE") // PENDING | IN_PROGRESS | DONE | REJECTED
  notes          String?
  createdAt      DateTime     @default(now())
}

// ─── مكتبة القوانين واللوائح ──────────────────────────────────────────────
model Regulation {
  id        Int      @id @default(autoincrement())
  code      String // 112.12 ، 2.15.617 ، 24.83 ...
  title     String
  year      Int
  category  String // LAW | DECREE | TAX | GUIDE | PRINCIPLE | INTERNATIONAL
  authority String // الجهة المصدرة
  summary   String
  keyPoints String // مصفوفة JSON لنقاط أساسية
  status    String   @default("IN_FORCE") // IN_FORCE | REPEALED | REFERENCE
  url       String?
  createdAt DateTime @default(now())
}

// ─── الالتزامات والمواعيد النظامية ────────────────────────────────────────
model ComplianceTask {
  id            Int          @id @default(autoincrement())
  cooperativeId Int
  cooperative   Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          String // ASSEMBLY | TAX | CNSS | ODCO | RENEWAL | OTHER
  dueDate       DateTime
  status        String       @default("PENDING") // PENDING | DONE
  createdAt     DateTime     @default(now())
}

// ─── طلبات الانخراط / التعاقد مع تعاونية ─────────────────────────────────
model JoinRequest {
  id             Int          @id @default(autoincrement())
  cooperativeId  Int
  cooperative    Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  userId         Int? // حساب المستخدم المرتبط (إن وجد)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String
  cin            String?
  phone          String?
  email          String?
  requestType    String       @default("MEMBERSHIP") // MEMBERSHIP انخراط | CONTRACT تعاقد
  motivation     String?
  shares         Int          @default(1) // الحصص المطلوبة (للانخراط)
  status         String       @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedBy      String? // من صادق أو رفض
  decisionNote   String?
  createdAt      DateTime     @default(now())
}

// ─── فرص العمل والتعاقد والخدمات ──────────────────────────────────────────
model Opportunity {
  id             Int      @id @default(autoincrement())
  cooperativeId  Int
  cooperative    Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  type           String // JOB منصب شاغر | CONTRACT فرصة تعاقد | SERVICE_NEEED حاجة خدمية | INTERNSHIP تدريب
  title          String
  description    String
  sector         String
  region         String
  city           String?
  positions      Int      @default(1) // عدد المناصب
  contractType   String? // CDI | CDD | SEASONAL | MISSION | PARTNERSHIP
  requirements   String? // المؤهلات والمتطلبات
  deadline       DateTime? // آخر أجل للترشح
  contactEmail   String?
  contactPhone   String?
  status         String   @default("OPEN") // OPEN | CLOSED
  createdAt      DateTime @default(now())
  applications   OpportunityApplication[]
}

// ─── ترشيحات على الفرص ────────────────────────────────────────────────────
model OpportunityApplication {
  id             Int          @id @default(autoincrement())
  opportunityId  Int
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId         Int? // حساب المستخدم المرشح (إن وجد)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String
  email          String?
  phone          String?
  motivation     String?
  experience     String? // نبذة عن التجربة والمؤهلات
  status         String       @default("PENDING") // PENDING | REVIEWED | ACCEPTED | REJECTED
  createdAt      DateTime     @default(now())
}

// ─── المتجر الإلكتروني ──────────────────────────────────────────────────────
model Product {
  id             Int          @id @default(autoincrement())
  cooperativeId  Int
  cooperative    Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       String // غذائي | حرفي | نسيج | خدمات | ...
  unit           String? // لتر، كغ، قطعة...
  price          Float // بالدرهم
  imageUrl       String?
  inStock        Boolean      @default(true)
  featured       Boolean      @default(false)
  status         String       @default("ACTIVE") // ACTIVE | HIDDEN
  createdAt      DateTime     @default(now())
  orders         Order[]
}

model Order {
  id           Int       @id @default(autoincrement())
  productId    Int
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int       @default(1)
  customerName String
  phone        String
  city         String?
  note         String?
  status       String    @default("NEW") // NEW | CONTACTED | DONE | CANCELLED
  createdAt    DateTime  @default(now())
}

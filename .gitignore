# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.DS_Store
*.pem

# production
/build
*.tsbuildinfo
next-env.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
server.log

# env files — لا تُرفع أبداً (تحتوي عنوان قاعدة البيانات والأسرار)
.env
.env.*
!.env.example

# database — ملف SQLite محلي لا يُرفع
db/*.db
db/*.db-journal
db/*.db.bak*

# static build temp
.static-build-tmp/

# vercel / cloudflare
.vercel
.wrangler

# sandbox / بيئة التطوير السحابية (خارج نطاق مستودع CMDP)
Caddyfile
.zscripts/
examples/
mini-services/
tests/
reference/
download/
skills/
local-*
.claude
.z-ai-config
prompt
test
tool-results/
# شهادة التوقيع وخصائصها — تُدار محلياً وفي GitHub Secrets فقط
android/cmdp-release.keystore
android/cmdp-release.keystore.properties
# مرفوعات المستخدم (لقطات وتوثيق التقارير) — لا تُرفع للمستودع العمومي
upload/

# secrets / binaries / tunnel logs — محلية فقط
secrets/
bin/
logs/
